package myorg:physics;

interface drag {
    record params {
        area: f64,
        cd: f64,
    }

    record inputs {
        rho: f64,
        velocity: f64,
    }

    record outputs {
        drag-force: f64,
        dynamic-pressure: f64,
    }

    resource model {
        constructor(p: params);
        step: func(i: inputs) -> outputs;
    }
}

world drag-model {
    export drag;
}
